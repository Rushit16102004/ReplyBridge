# App Settings
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database Settings
DATABASE_URL=sqlite:///./replybridge.db

# JWT Session Auth
JWT_SECRET_KEY=dev_jwt_signing_secret_key_change_in_production_12345678

# Google OAuth Credentials
# Retrieve these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Gemini AI Credentials
# Retrieve this from Google AI Studio (a_key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
